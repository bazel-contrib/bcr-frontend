load("@build_stack_rules_proto//rules:proto_compiled_sources.bzl", "proto_compiled_sources")
load("@rules_go//go:def.bzl", "go_library")
load("@rules_proto//proto:defs.bzl", "proto_library")

proto_library(
    name = "worker_proto",
    srcs = ["worker.proto"],
    visibility = ["//visibility:public"],
    deps = [
        "@googleapis//google/rpc:status_proto",
        "@protobufapis//google/protobuf:duration_proto",
        "@protobufapis//google/protobuf:timestamp_proto",
        "@remoteapis//build/bazel/remote/execution/v2:remote_execution_proto",
    ],
)

proto_library(
    name = "observer_proto",
    srcs = ["observer.proto"],
    visibility = ["//visibility:public"],
    deps = [
        "@googleapis//google/rpc:code_proto",
        "@protobufapis//google/protobuf:timestamp_proto",
        "@remoteapis//build/bazel/remote/execution/v2:remote_execution_proto",
    ],
)

proto_library(
    name = "remoteexecution_proto",
    visibility = ["//visibility:public"],
    deps = [
        ":observer_proto",
        ":worker_proto",
        "//bazel_tools/proto:reapi_proto",
    ],
)

proto_compiled_sources(
    name = "remoteexecution_go_compiled_sources",
    srcs = [
        "observer.pb.go",
        "observer_grpc.pb.go",
        "worker.pb.go",
        "worker_grpc.pb.go",
    ],
    output_mappings = [
        "observer.pb.go=github.com/bazel-contrib/bcr-frontend/build/stack/bazel/remoteexecution/v1/observer.pb.go",
        "observer_grpc.pb.go=github.com/bazel-contrib/bcr-frontend/build/stack/bazel/remoteexecution/v1/observer_grpc.pb.go",
        "worker.pb.go=github.com/bazel-contrib/bcr-frontend/build/stack/bazel/remoteexecution/v1/worker.pb.go",
        "worker_grpc.pb.go=github.com/bazel-contrib/bcr-frontend/build/stack/bazel/remoteexecution/v1/worker_grpc.pb.go",
    ],
    plugins = [
        "@build_stack_rules_proto//plugin/golang/protobuf:protoc-gen-go",
        "@build_stack_rules_proto//plugin/grpc/grpc-go:protoc-gen-go-grpc",
    ],
    protos = [
        ":observer_proto",
        ":worker_proto",
    ],
    visibility = ["//visibility:public"],
)

go_library(
    name = "remoteexecution",
    srcs = [
        "observer.pb.go",
        "observer_grpc.pb.go",
        "worker.pb.go",
        "worker_grpc.pb.go",
    ],
    importpath = "github.com/bazel-contrib/bcr-frontend/build/stack/bazel/remoteexecution/v1",
    visibility = ["//visibility:public"],
    deps = [
        "@com_github_bazelbuild_remote_apis//build/bazel/remote/execution/v2:execution",
        "@org_golang_google_genproto_googleapis_rpc//code",
        "@org_golang_google_genproto_googleapis_rpc//status",
        "@org_golang_google_grpc//:grpc",
        "@org_golang_google_grpc//codes",
        "@org_golang_google_grpc//status",
        "@org_golang_google_protobuf//reflect/protoreflect",
        "@org_golang_google_protobuf//runtime/protoimpl",
        "@org_golang_google_protobuf//types/known/durationpb",
        "@org_golang_google_protobuf//types/known/timestamppb",
    ],
)
