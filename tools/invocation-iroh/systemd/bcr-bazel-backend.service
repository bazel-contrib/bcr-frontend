[Unit]
Description=Bazel build event and invocation server

[Service]
Type=exec
Environment=BCR_BES_LISTEN=127.0.0.1:1973
Environment=BCR_INVOCATION_HTTP_PORT=1974
Environment=BCR_FRONTEND_ORIGIN=https://registry.bazel.build
EnvironmentFile=-%E/bcr-invocation-observer/environment
StateDirectory=bcr-invocation-observer
StateDirectoryMode=0700
UMask=0077
ExecStart=/bin/sh -c 'exec "$${XDG_DATA_HOME:-$$HOME/.local/share}/bcr-invocation-observer/current/bazel_backend" "$$@"' bcr-bazel-backend \
  --bes_backend_grpc_listen=${BCR_BES_LISTEN} --http_listen=127.0.0.1:${BCR_INVOCATION_HTTP_PORT} \
  --http_allow_origin=${BCR_FRONTEND_ORIGIN} --bes_backend_sqlite=${STATE_DIRECTORY}/invocations.sqlite $BCR_BES_ARGS
Restart=on-failure
RestartSec=5s
TimeoutStopSec=15s

[Install]
WantedBy=default.target
