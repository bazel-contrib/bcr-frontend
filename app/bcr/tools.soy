{namespace soy.bcrfrontend.tools}

import {
  octiconAlert16,
  octiconBeaker16,
  octiconCheckCircleFill16,
  octiconCircle16,
  octiconCircleSlash16,
  octiconDatabase16,
  octiconFile16,
  octiconGraph16,
  octiconLog16,
  octiconPulse16,
  octiconServer16,
  octiconStop16,
  octiconTerminal16,
  octiconXCircleFill16
} from 'app/bcr/octicons.soy';

import {logo} from 'app/bcr/app.soy';
import {sectionHeader} from 'app/bcr/registry.soy';

{template toolsSelect}
  <div class="mt-3">
    <div class="{css('content')}"></div>
  </div>
{/template}

{template eventStatusIcon}
  {@param success: bool}
  {if $success}
    <span class="d-flex color-fg-success" title="Successful" aria-label="Successful">
      {octiconCheckCircleFill16()}
    </span>
  {else}
    <span class="d-flex color-fg-danger" title="Failed" aria-label="Failed">
      {octiconXCircleFill16()}
    </span>
  {/if}
{/template}

{template invocationResultGlyph}
  {@param kind: string}
  {switch $kind}
    {case 'success'}{octiconCheckCircleFill16()}
    {case 'failure'}{octiconXCircleFill16()}
    {case 'tests'}{octiconBeaker16()}
    {case 'interrupted'}{octiconStop16()}
    {case 'input'}{octiconTerminal16()}
    {case 'empty'}{octiconCircleSlash16()}
    {case 'infrastructure', 'warning'}{octiconAlert16()}
    {case 'running'}<span class="bes-invocation-spinner" aria-hidden="true"></span>
    {default}{octiconCircle16()}
  {/switch}
{/template}

{template toolSettingsLink}
  <a class="text-small" href="/settings/tools">Tools settings</a>
{/template}

{template toolsSidebar}
  {@param current: string}
  <section class="bes-events-side-section">
    {sectionHeader(title: 'Tools')}
    <nav class="tools-sidebar-links" aria-label="Tools">
      <a class="tools-sidebar-index" href="/tools">All tools</a>
      {toolLinks(current: $current)}
    </nav>
  </section>
{/template}

{template toolLinks visibility="private"}
  {@param? current: string}
  {@param? diagram: bool}
  {toolLink(id: 'invocations', label: 'Build Events', current: $current, diagram: $diagram)}
  {toolLink(id: 'remote-execution', label: 'Remote Execution', current: $current, diagram: $diagram)}
  {toolLink(id: 'action-query', label: 'Action Query', current: $current, diagram: $diagram)}
  {toolLink(id: 'execution-log', label: 'Execution Log', current: $current, diagram: $diagram)}
  {toolLink(id: 'remote-cache', label: 'Remote Cache', current: $current, diagram: $diagram)}
{/template}

{template toolLink visibility="private"}
  {@param id: string}
  {@param label: string}
  {@param? current: string}
  {@param? diagram: bool}
  <a href="/tools/{$id}" class="{if $diagram}tools-net-face tools-net-face-{$id}{else}tools-sidebar-link{/if}"
    {if $id == $current}aria-current="page"{/if}>
    <span class="tools-link-icon" aria-hidden="true">
      {switch $id}
        {case 'invocations'}{octiconPulse16()}
        {case 'remote-execution'}{octiconServer16()}
        {case 'action-query'}{octiconGraph16()}
        {case 'execution-log'}{octiconLog16()}
        {case 'remote-cache'}{octiconDatabase16()}
      {/switch}
    </span>
    <span>{$label}</span>
  </a>
{/template}

{template toolsCatalog}
  <div class="tools-catalog">
    <h1 class="h2 mb-2">Tools</h1>
    <p class="color-fg-muted">Explore Bazel builds, action graphs, remote execution, and cache activity.</p>
    <figure class="tools-net">
      <div class="tools-net-window">
        <div class="tools-net-sheet">
          <svg class="tools-net-art" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 820 556"
            aria-hidden="true" focusable="false">
            <path class="tools-net-paper" d="M458 100H475L485 82H651L661 100H678V186H764V201L782 211V273L764 283V312L782 322V381L764 391V406H690L678 394V296H568V406H678V492H552L542 510H484L474 492H458V406H360L350 424H284L274 406H262V296H152V283L134 273V211L152 201V186H163L173 168H240L250 186H274L284 168H350L360 186H458Z"/>
            <path class="tools-net-face-shade" d="M458 100H678V186H458Z M458 186H764V296H568V406H458Z"/>
            <path class="tools-net-back" d="M152 186H372V406H262V296H152Z"/>
            <path class="tools-net-score" d="M458 186H678V296H764 M458 186V406H568V492 M372 186V406 M475 100H661 M764 201V283 M764 312V391 M474 492H552 M274 406H360 M152 201V283 M163 186H250 M274 186H360"/>
            <path class="tools-net-face-seam" d="M568 186V296H458 M372 296H262V186"/>
          </svg>
          <nav class="tools-net-links" aria-label="Bazel tools">
            {toolLinks(diagram: true)}
          </nav>
        </div>
      </div>
      <figcaption class="tools-net-caption">
        <span class="tools-net-preview" aria-hidden="true">{logo()}</span>
        <div>
          <strong>Bazel logo fold-out</strong>
          <div class="tools-net-key">
            <span><i aria-hidden="true"></i>Cut along solid lines</span>
            <span><i aria-hidden="true"></i>Fold along dashed lines</span>
            <span>Tuck the tabs inside</span>
          </div>
        </div>
      </figcaption>
    </figure>
  </div>
{/template}

{template invocationGroups}
  {@param altKeyLabel: string}
  <div class="PageLayout PageLayout--panePos-start PageLayout--hasPaneDivider PageLayout--responsive-stackRegions PageLayout--responsive-panePos-start bes-events-layout">
    <div class="PageLayout-columns">
      <div class="PageLayout-pane bes-events-sidebar">
        <h1 class="h2 mb-2">Build Events</h1>
        <p class="color-fg-muted mb-0">Upload a build events file or connect to a{sp}
          <a href="https://github.com/bazel-contrib/bcr-frontend">build event stream backend</a>.</p>
        <section class="bes-events-side-section" aria-label="Backend">
          {sectionHeader(title: 'Backend')}
          <form class="bes-backend-form {css('igroup-form')}" aria-label="Backend">
            <label>Group
              <input class="form-control input-block {css('igroup-name')}" type="text"
                  maxlength="128" pattern="[A-Za-z0-9][A-Za-z0-9._\-]*" placeholder="release">
            </label>
            <div class="bes-backend-actions">
              <button type="submit" class="btn btn-primary btn-sm">Connect</button>
              {toolSettingsLink()}
              <span class="Label {css('igroup-backend-label')}" role="status">Disconnected</span>
            </div>
            <div class="bes-backend-detail text-small color-fg-muted {css('igroup-backend-detail')}">Uses the Build Event Backend in Tools settings.</div>
            <div class="bes-group-controls text-small color-fg-muted">
              <label class="bes-group-option" title="Open new group builds automatically. Opening a run pauses follow. Check Follow to resume.">
                <input type="checkbox" class="{css('igroup-follow')}" checked> Follow
              </label>
              <label class="bes-group-option" title="Open the latest finished run when you connect and no active build is being followed.">
                <input type="checkbox" class="{css('igroup-show-last')}" checked> Show last
              </label>
            </div>
          </form>
        </section>
        <section class="bes-events-side-section" aria-label="Keyboard Shortcuts">
          {sectionHeader(title: 'Keyboard Shortcuts')}
          {buildEventShortcut(view: 'current', label: 'Invocation', key: '1', altKeyLabel: $altKeyLabel)}
          {buildEventShortcut(view: 'group', label: 'Group', key: '2', altKeyLabel: $altKeyLabel)}
          {buildEventShortcut(view: 'groups', label: 'Groups', key: '3', altKeyLabel: $altKeyLabel)}
          {buildEventShortcut(view: 'tests', label: 'Tests', key: '4', altKeyLabel: $altKeyLabel)}
          {buildEventShortcut(view: 'upload', label: 'Upload', key: '5', altKeyLabel: $altKeyLabel)}
        </section>
        {toolsSidebar(current: 'invocations')}
      </div>
      <div class="PageLayout-content bes-events-content">
        <nav class="UnderlineNav bes-events-nav" aria-label="Build event views">
          <div class="UnderlineNav-body">
            <a class="UnderlineNav-item" id="igroup-nav-current" href="/tools/invocations/-/current"
                data-view="current" aria-current="location">Invocation</a>
            <a class="UnderlineNav-item" id="igroup-nav-group" href="/tools/invocations/-/group" data-view="group">Group</a>
            <a class="UnderlineNav-item" id="igroup-nav-groups" href="/tools/invocations/-/groups" data-view="groups">Groups</a>
            <a class="UnderlineNav-item" id="igroup-nav-tests" href="/tools/invocations/-/tests" data-view="tests">Tests</a>
            <a class="UnderlineNav-item" id="igroup-nav-upload" href="/tools/invocations/-/upload" data-view="upload">Upload</a>
          </div>
        </nav>
        <div class="{css('igroup-content')}">
          <div role="region" id="igroup-panel-current" aria-labelledby="igroup-nav-current" tabindex="0">
            <p class="bes-group-empty {css('igroup-status')}" role="status">Connect to a backend and choose a group to follow builds.</p>
            <div class="d-none {css('igroup-viewer')}"></div>
          </div>
          <div role="region" id="igroup-panel-group" aria-labelledby="igroup-nav-group" tabindex="0" hidden>
            <div class="bes-group-totals {css('igroup-totals')}" hidden>
              <div class="{css('igroup-build-metrics')}"></div>
            </div>
            <div class="bes-group-controls bes-group-table-controls">
              <label><span id="igroup-metric-label">Metric</span>
                <select class="form-select select-sm {css('igroup-metric')}" aria-labelledby="igroup-metric-label"></select>
              </label>
              <label><span id="igroup-binning-label">Group by</span>
                <select class="form-select select-sm {css('igroup-binning')}" aria-labelledby="igroup-binning-label">
                  <option value="0">Per build</option>
                  <option value="3600000">Hour (UTC)</option>
                  <option value="86400000">Day (UTC)</option>
                </select>
              </label>
            </div>
            <div class="bes-group-runs">
              <table class="bes-group-run-table bes-group-filter-table" aria-label="Invocation runs">
                <thead>
                  <tr>
                    <th scope="col" aria-labelledby="igroup-status-heading">
                      <details class="bes-group-status-filter">
                        <summary id="igroup-status-heading">Status</summary>
                        <fieldset class="{css('igroup-status-options')}" aria-label="Filter by status"></fieldset>
                      </details>
                    </th>
                    <th scope="col">
                      <label>Invocation
                        <input class="form-control input-sm {css('igroup-id-filter')}" type="search" placeholder="ID prefix">
                      </label>
                    </th>
                    <th scope="col">
                      <label>Command
                        <input class="form-control input-sm {css('igroup-command-filter')}" type="search"
                            placeholder="Filter commands" list="igroup-command-options">
                      </label>
                      <datalist id="igroup-command-options"></datalist>
                    </th>
                    <th scope="col">
                      <label><span id="igroup-window-label">Time</span>
                        <select class="form-select select-sm {css('igroup-window')}" aria-labelledby="igroup-window-label">
                          <option value="7">Last 7 days</option>
                          <option value="30" selected>Last 30 days</option>
                          <option value="90">Last 90 days</option>
                        </select>
                      </label>
                    </th>
                    <th scope="col" class="bes-group-run-stat">
                      <span class="bes-group-run-heading {css('igroup-metric-heading')}" title="Build time">Build time</span>
                    </th>
                  </tr>
                </thead>
                <tbody class="{css('igroup-runs')}"></tbody>
              </table>
            </div>
            <p class="bes-group-empty {css('igroup-runs-empty')}">Connect to a backend and choose a group to see its runs.</p>
            <div class="mt-2">
              <button type="button" class="btn btn-sm {css('igroup-older-runs')}" hidden>Load older runs</button>
              <span class="text-small color-fg-muted ml-2 {css('igroup-page-status')}" role="status"></span>
            </div>
          </div>
          <div role="region" id="igroup-panel-groups" aria-labelledby="igroup-nav-groups" tabindex="0" hidden>
            <p class="bes-group-empty {css('igroup-catalog-status')}" role="status">Connect to a backend to see its groups.</p>
            <table class="bes-group-run-table bes-group-catalog" aria-label="Available invocation groups" hidden>
              <thead><tr>
                <th scope="col">Group name</th>
                <th scope="col" class="bes-group-catalog-count">Invocations</th>
                <th scope="col" class="bes-group-catalog-time">Last invocation</th>
              </tr></thead>
              <tbody class="{css('igroup-list')}"></tbody>
            </table>
          </div>
          <div role="region" id="igroup-panel-tests" aria-labelledby="igroup-nav-tests" tabindex="0" hidden>
            <div class="{css('igroup-test-metrics')}">
              <p class="bes-group-empty">Connect to a backend and choose a group to see test results.</p>
            </div>
          </div>
          <div role="region" id="igroup-panel-upload" aria-labelledby="igroup-nav-upload" tabindex="0" hidden>
            <div class="bes-upload-target bes-upload-target-large" role="region" aria-label="Upload build events">
              <span class="color-fg-muted" aria-hidden="true">{octiconFile16()}</span>
              <strong>Drop a build events file</strong>
              <p class="text-small color-fg-muted mb-1">Use a file from <code>--build_event_binary_file</code>.</p>
              <button type="button" class="btn btn-outline {css('igroup-choose-file')}">Choose File</button>
              <input type="file" class="d-none {css('igroup-file-input')}" aria-label="Choose a binary build event file">
              <p class="text-small mb-0 {css('igroup-upload-status')}" role="status" hidden></p>
            </div>
            <div class="mt-3 d-none {css('igroup-upload-viewer')}"></div>
          </div>
        </div>
      </div>
    </div>
  </div>
{/template}

{template buildEventShortcut}
  {@param view: string}
  {@param label: string}
  {@param key: string}
  {@param altKeyLabel: string}
  <a class="Link--primary d-flex flex-items-center mb-2 text-small" href="/tools/invocations/-/{$view}" data-view="{$view}"
      data-shortcut="Digit{$key}" aria-keyshortcuts="Alt+Shift+{$key}">
    <span class="color-fg-muted">{$label}</span>
    <span class="dotted-leader" aria-hidden="true"></span>
    <span><kbd>{$altKeyLabel}</kbd> <kbd>Shift</kbd> <kbd>{$key}</kbd></span>
  </a>
{/template}

{template invocationGroupUsage}
  <section>
    {sectionHeader(title: 'How Invocation Groups work')}
    <div class="bes-group-usage">
      <p>Run these commands from the root of the source checkout.</p>
      <ol class="bes-group-setup">
        <li>
          <h3 class="h4">Build and start the backend</h3>
          <pre><code>{'bazel build //cmd/bazel_backend'}{\n}
          {'"$(bazel info bazel-bin)/cmd/bazel_backend/bazel_backend_/bazel_backend"'} \{\n}
          {'  '}--bes_backend_grpc_listen=localhost:1973 --http_listen=localhost:1974 \{\n}
          {'  '}--http_allow_origin=https://registry.bazel.build --bes_backend_sqlite=invocations.sqlite</code></pre>
        </li>
        <li>
          <h3 class="h4">Build and start the Iroh companion for remote viewing</h3>
          <p>On the backend machine, open another terminal in the same checkout.</p>
          <pre><code>{'bazel build -c opt //tools/invocation-iroh'}{\n}
          {'"$(bazel info -c opt bazel-bin)/tools/invocation-iroh/invocation-iroh"'} --backend-port 1974 --key-file ./iroh.key</code></pre>
          <p>The companion creates <code>iroh.key</code> if it is missing. Reuse the same key file across restarts to keep a stable Iroh address.</p>
          <p>The printed Iroh ticket looks like <code>bcr-iroh-v1:eyJlbmRwb2ludCI6…</code>. Paste the full ticket into <strong>Build Event Backend</strong> in Tools settings.</p>
          <p>The browser uses the relay address in the ticket to reach the companion and presents the ticket’s access credential. The companion reads group data and streams build events from the backend’s local HTTP API.</p>
        </li>
        <li>
          <h3 class="h4">Publish a grouped build</h3>
          <p>Use an address reachable from Bazel for <code>--bes_backend</code>. Publishing all actions includes successful actions in the event graph.</p>
          <pre><code>{'bazel build //path:target'} \{\n}
          {'  '}--bes_backend=grpc://localhost:1973 \{\n}
          {'  '}--bes_results_url=https://registry.bazel.build/tools/invocations/release/ \{\n}
          {'  '}--build_metadata=igroup=release \{\n}
          {'  '}--build_event_publish_all_actions</code></pre>
          <p>Bazel appends the invocation ID to the results URL. Keep the trailing slash and match the group in the URL to the group in <code>--build_metadata</code>.</p>
        </li>
      </ol>
      <details>
        <summary class="text-small color-fg-muted">Run the backend with Bazel or develop the viewer locally</summary>
        <p class="mt-2 mb-0">To run the backend with Bazel, use <code>{'bazel run //cmd/bazel_backend --'}</code> followed by the same flags. For local viewer development, set <code>--http_allow_origin=http://localhost:8080</code> and run:</p>
        <pre><code>{'bazel run //app/bcr:release --//app/bcr:release_type=dummy'}</code></pre>
      </details>
    </div>
  </section>
{/template}

{template invocationViewer}
  {@param idPrefix: string}
  <div class="bes-invocation">
    <header class="bes-invocation-heading">
      <span class="bes-invocation-icon {css('bes-heading-icon')}" aria-hidden="true"></span>
      <h2 class="bes-invocation-title"><code class="{css('bes-heading-id')}"></code></h2>
      <div class="bes-tabs d-none {css('bes-tabs')}" role="tablist" aria-label="Invocation views">
        <button type="button" role="tab" id="{$idPrefix}-bes-tab-overview" aria-controls="{$idPrefix}-bes-panel-overview"
            aria-selected="true" tabindex="0">Overview</button>
        <button type="button" role="tab" id="{$idPrefix}-bes-tab-terminal" aria-controls="{$idPrefix}-bes-panel-terminal"
            aria-selected="false" tabindex="-1">Terminal</button>
        <button type="button" role="tab" id="{$idPrefix}-bes-tab-tests" aria-controls="{$idPrefix}-bes-panel-tests"
            aria-selected="false" tabindex="-1">Tests</button>
        <button type="button" role="tab" id="{$idPrefix}-bes-tab-metrics" aria-controls="{$idPrefix}-bes-panel-metrics"
            aria-selected="false" tabindex="-1">Metrics</button>
      </div>
      <div class="bes-invocation-timing">
        <span class="bes-invocation-state text-small text-bold {css('bes-heading-state')}"></span>
        <time class="text-mono bes-invocation-elapsed {css('bes-heading-elapsed')}" aria-label="Build elapsed time" hidden></time>
      </div>
    </header>
    <div class="d-none {css('results')}">
      <div class="bes-overview-panel" role="tabpanel" id="{$idPrefix}-bes-panel-overview" aria-labelledby="{$idPrefix}-bes-tab-overview" tabindex="0">
        <div class="{css('summary')}"></div>
        <div class="bes-invocation-log {css('bes-log-body')}" hidden>
          <div class="bes-terminal {css('bes-log')}" tabindex="0" role="region" aria-label="Build terminal output"></div>
          <p class="px-3 py-1 mb-0 text-small color-fg-muted {css('bes-log-limit')}" hidden>Showing recent output</p>
        </div>
        <section class="bes-invocation-failure {css('bes-failure-body')}" aria-label="Build failure" hidden></section>
        <section class="bes-build-stats {css('bes-build-stats')}" aria-label="Build statistics" hidden></section>
        <div class="bes-overview-path {css('bes-critical-path')}"></div>

        <section class="Box Box--condensed mb-3" aria-labelledby="{$idPrefix}-bes-frontier-title">
          <header class="Box-header">
            <h2 class="Box-title" id="{$idPrefix}-bes-frontier-title">Build frontier</h2>
            <div class="d-flex flex-wrap flex-items-center flex-justify-between">
              <span class="color-fg-muted text-small {css('bes-frontier-count')}"></span>
              <span class="bes-frontier-key color-fg-muted text-small">
                <span><span class="bes-frontier-outline"></span>Expected</span>
                <span><span class="bes-frontier-solid"></span>Received</span>
                <span><span class="bes-frontier-action"></span>Action</span>
                <span><span class="bes-frontier-shared"></span>Shared dependency</span>
              </span>
            </div>
          </header>
          <div class="bes-frontier-stage">
            <div class="{css('bes-frontier-scroll')}">
              <canvas class="{css('bes-frontier-canvas')}" tabindex="0"
                  aria-label="Build event graph. Dependencies flow right to left. Progress events occupy the top row and expected events the left column. Use arrow keys to inspect events."></canvas>
              <div class="{css('bes-frontier-spacer')}" aria-hidden="true"></div>
            </div>
            <div class="bes-frontier-readers">
              <span class="bes-frontier-arrival bes-frontier-arrival-success" aria-hidden="true"></span>
              <span class="bes-frontier-arrival bes-frontier-arrival-failed" aria-hidden="true"></span>
              <div class="bes-frontier-reader {css('bes-frontier-reader')}" role="group" aria-label="Last completed action">
                <span class="bes-frontier-reader-dot" aria-hidden="true"></span>
                <strong class="bes-frontier-reader-mnemonic">—</strong>
                <code class="bes-frontier-reader-output color-fg-muted"></code>
              </div>
            </div>
            <div class="bes-frontier-flights {css('bes-frontier-flights')}" aria-hidden="true"></div>
          </div>
          <div class="Box-body">
            <h3 class="h5 mb-1">Received action mnemonics</h3>
            <div class="{css('bes-frontier-mnemonics')}"></div>
          </div>
          <div class="Box-footer">
            <div class="bes-event-heading">
              <div class="bes-event-type {css('bes-frontier-type')}" hidden>
                <span class="bes-event-swatch {css('bes-frontier-swatch')}" aria-hidden="true"></span>
                <h3 class="h4 m-0 {css('bes-frontier-type-name')}"></h3>
                <span class="{css('bes-frontier-outcome')}"></span>
              </div>
              <div class="bes-event-caption color-fg-muted text-small">
                <div class="{css('bes-frontier-caption')}" aria-live="polite">Select a mark to inspect its event and connections.</div>
                <time class="text-mono {css('bes-frontier-wait')}" aria-label="Time waiting for event" hidden></time>
              </div>
            </div>
            <div class="{css('bes-frontier-detail')}"></div>
          </div>
        </section>

      </div>

      <div role="tabpanel" id="{$idPrefix}-bes-panel-terminal" aria-labelledby="{$idPrefix}-bes-tab-terminal" tabindex="0" hidden>
        <div class="bes-terminal-tools mb-2">
          <input type="search" class="form-control input-sm {css('bes-log-search')}" placeholder="Search terminal"
                 aria-label="Search terminal" aria-describedby="bes-log-search-result"
                 title="Enter for next match. Shift+Enter for previous match.">
          <span id="{$idPrefix}-bes-log-search-result" class="text-small color-fg-muted {css('bes-log-search-result')}" role="status"></span>
          <button type="button" class="btn btn-sm {css('bes-download-log')}" disabled>Download log</button>
        </div>
        <div class="bes-terminal bes-terminal-full {css('bes-log-full')}" tabindex="0"
             role="region" aria-label="Full build terminal output"></div>
      </div>

      <div role="tabpanel" id="{$idPrefix}-bes-panel-tests" aria-labelledby="{$idPrefix}-bes-tab-tests" tabindex="0" hidden>
        <div class="{css('bes-tests')}"></div>
      </div>

      <div role="tabpanel" id="{$idPrefix}-bes-panel-metrics" aria-labelledby="{$idPrefix}-bes-tab-metrics" tabindex="0" hidden>
        <div class="{css('bes-metrics')}"></div>
        <section class="mt-4">
          {sectionHeader(title: 'Remote cache')}
          <div class="{css('bes-cache-stats')}"></div>
        </section>
      </div>
    </div>
  </div>
{/template}

{template remoteCache}
  <div class="PageLayout PageLayout--panePos-start PageLayout--hasPaneDivider PageLayout--responsive-stackRegions PageLayout--responsive-panePos-start">
    <div class="PageLayout-columns">
      <aside class="PageLayout-pane bes-events-sidebar">
        <h1 class="h2 mb-2">Remote Cache</h1>
        <p class="color-fg-muted mb-0">Watch live Bazel cache traffic, hit rate, and disk usage.</p>
        <section class="bes-events-side-section" aria-label="Cache server">
          {sectionHeader(title: 'Cache server')}
          <form class="bes-backend-form" data-cache="connect">
            <div class="bes-backend-actions">
              <button class="btn btn-primary btn-sm" type="submit">Connect</button>
              {toolSettingsLink()}
              <span class="Label" data-cache="state" role="status">Disconnected</span>
            </div>
            <div class="bes-backend-detail text-small color-fg-muted" data-cache="detail">Uses the Remote Cache status API in Tools settings.</div>
          </form>
        </section>
        {toolsSidebar(current: 'remote-cache')}
      </aside>
      <div class="PageLayout-content bes-events-content">
        <p class="color-fg-muted" data-cache="empty">Connect to a cache server to see its activity.</p>
        <div class="cache-dashboard" data-cache="dashboard" hidden>
          <section aria-label="Cache overview">
            <label class="d-block mb-3">REAPI instance
              <select class="form-select ml-2" data-cache="instance">
                <option value="">All instances</option>
              </select>
            </label>
            <div class="cache-dashboard-cards">
              {remoteCacheStat(label: 'Upload', key: 'upload')}
              {remoteCacheStat(label: 'Download', key: 'download')}
              {remoteCacheStat(label: 'Active transfers', key: 'transfers')}
              {remoteCacheStat(label: 'Connections', key: 'connections')}
              {remoteCacheStat(label: 'Action cache hit rate', key: 'hit-rate')}
            </div>
          </section>
          <section aria-label="Traffic">
            {sectionHeader(title: 'Live traffic')}
            <div class="cache-chart-key text-small">
              <span><i class="cache-upload-line"></i>Upload</span>
              <span><i class="cache-download-line"></i>Download</span>
            </div>
            <div class="cache-chart">
              <div class="cache-chart-axis text-small color-fg-muted" aria-hidden="true">
                <span data-cache="chart-max">—</span>
                <span data-cache="chart-mid">—</span>
                <span>0</span>
              </div>
              <svg class="cache-chart-plot" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 120 100" preserveAspectRatio="none"
                  role="img" aria-label="Cache upload and download speeds over the last two minutes">
                <path class="cache-chart-grid" d="M0 1H120 M0 25H120 M0 50H120 M0 75H120 M0 99H120 M30 1V99 M60 1V99 M90 1V99"/>
                <polyline data-cache="chart-upload" class="cache-upload-line"/>
                <polyline data-cache="chart-download" class="cache-download-line"/>
              </svg>
            </div>
            <div class="cache-chart-time text-small color-fg-muted"><span>2 min ago</span><span>Now</span></div>
          </section>
          <section aria-label="Storage">
            {sectionHeader(title: 'Shared storage')}
            <p data-cache="storage-summary"></p>
            <progress class="cache-storage-progress" data-cache="storage-progress" aria-label="Cache disk budget used" hidden></progress>
            <div class="cache-dashboard-cards">
              {remoteCacheStat(label: 'Available on disk', key: 'disk-free')}
              {remoteCacheStat(label: 'Upload space reserved', key: 'reserved')}
              {remoteCacheStat(label: 'Evicted since startup', key: 'evicted')}
            </div>
          </section>
        </div>
      </div>
    </div>
  </div>
{/template}

{template remoteCacheStat visibility="private"}
  {@param label: string}
  {@param key: string}
  <dl class="cache-dashboard-card">
    <dt class="text-small color-fg-muted">{$label}</dt>
    <dd class="h3" data-cache="{$key}">—</dd>
    <dd class="text-small color-fg-muted" data-cache="{$key}-detail"></dd>
  </dl>
{/template}

{template remoteExecution}
  <div class="PageLayout PageLayout--panePos-start PageLayout--hasPaneDivider PageLayout--responsive-stackRegions PageLayout--responsive-panePos-start bes-events-layout">
    <div class="PageLayout-columns">
      <aside class="PageLayout-pane bes-events-sidebar">
        <h1 class="h2 mb-2">Remote Execution</h1>
        <p class="color-fg-muted mb-0">Run Bazel build actions on a pool of workers. Connect to a scheduler to see pool capacity, queued and running actions, and worker history.</p>
        <section class="bes-events-side-section" aria-label="Scheduler">
          {sectionHeader(title: 'Scheduler')}
          <form class="bes-backend-form" data-rex="connect" aria-label="Scheduler">
            <div class="bes-backend-actions">
              <button class="btn btn-primary btn-sm" type="submit">Connect</button>
              {toolSettingsLink()}
              <span class="Label" data-rex="status" role="status">Disconnected</span>
            </div>
            <div class="bes-backend-detail text-small color-fg-muted" data-rex="status-detail"></div>
          </form>
        </section>
        {toolsSidebar(current: 'remote-execution')}
      </aside>
      <div class="PageLayout-content bes-events-content">
        <header class="rex-navigation">
          <nav aria-label="Remote execution breadcrumb">
            <ol class="rex-breadcrumb" data-rex="breadcrumb"><li><span aria-current="page">Scheduler</span></li></ol>
          </nav>
          <div class="d-flex flex-wrap gap-2">
            <a href="/tools/remote-execution/instances" class="btn btn-sm">Instances</a>
            <a href="/tools/remote-execution/manage" class="btn btn-sm">Manage pools and instances</a>
          </div>
        </header>
        <div class="mt-3" data-rex="instance-filter" hidden>
          <label>Execution instance
            <select class="form-select ml-2" data-rex="instance-choice">
              <option value="">All instances</option>
            </select>
          </label>
        </div>
        <section class="rex-timeline" data-rex="timeline" aria-label="Live scheduling" hidden></section>
        <section class="pt-3 rex-panel" data-rex="panel" aria-label="Pools">
          <p class="color-fg-muted">Connect to a scheduler to view worker pools.</p>
        </section>
        {remoteExecutionPoolSettings()}
      </div>
    </div>
  </div>
{/template}

{template remoteExecutionPoolSettings visibility="private"}
  <section class="pt-3" data-rex="manage" aria-label="Manage pools and instances" hidden>
    <h2 class="h3 mb-2">Manage pools and instances</h2>
    <p>Load settings using the scheduler admin connection from {toolSettingsLink()}.</p>
    <form class="bes-backend-form mb-3" data-rex="admin-connect" aria-label="Pool administration">
      <button class="btn" data-rex="admin-load" type="submit">Load settings</button>
    </form>
    <p class="color-fg-muted" data-rex="admin-status" role="status"></p>
    <form class="mb-4" data-rex="admin-instance-form" aria-label="Instance settings" hidden>
      <h3 class="h4">Execution instance</h3>
      <div class="bes-backend-form">
        <label>REAPI instance name
          <input class="form-control input-block" data-rex="admin-instance-name" type="text" placeholder="builds">
        </label>
        <label>Instance display name
          <input class="form-control input-block" data-rex="admin-instance-display" type="text" maxlength="256">
        </label>
        <p class="text-small color-fg-muted mb-0">Leave the REAPI name blank for the default instance. Reuse a name to update its display name.</p>
        <button class="btn" data-rex="admin-save-instance" type="submit">Save instance</button>
      </div>
    </form>
    <form data-rex="admin-form" aria-label="Pool settings" hidden>
      <h3 class="h4">Worker pool</h3>
      <div class="bes-backend-form">
        <label>Pool to configure
          <select class="form-select input-block" data-rex="admin-pool"></select>
        </label>
        <label>Pool ID
          <input class="form-control input-block" data-rex="admin-id" type="text" maxlength="128" required>
        </label>
        <label>Display name
          <input class="form-control input-block" data-rex="admin-name" type="text" maxlength="256" required>
        </label>
        <label>Bazel remote instance
          <select class="form-select input-block" data-rex="admin-instance"></select>
        </label>
        <label>Platform properties (one NAME=VALUE per line)
          <textarea class="form-control input-block" data-rex="admin-platform" rows="2" placeholder="OSFamily=Linux"></textarea>
        </label>
        <label>Iroh gateway ID (from gateway.id)
          <input class="form-control input-block" data-rex="admin-gateway" type="text" maxlength="64" autocomplete="off">
        </label>
        <label>Revoked Iroh worker IDs (one per line)
          <textarea class="form-control input-block" data-rex="admin-revoked" rows="2"></textarea>
        </label>
        <button class="btn btn-primary" data-rex="admin-save" type="submit">Save pool</button>
      </div>
    </form>
  </section>
{/template}

{template remoteExecutionUsage}
  <section aria-label="Remote execution usage">
    <div class="bes-group-usage">
      <h2 class="h3 mb-0">Set up remote execution</h2>
      <p class="mb-0"><code>bazel_backend</code> schedules actions and serves the remote cache. Bazel submits actions over gRPC. Workers connect to the scheduler over HTTP or through an Iroh gateway.</p>
      <ol class="bes-group-setup">
        <li>
          <h3 class="h4">Start the scheduler</h3>
          <p>Run these commands in the BCR frontend source checkout. Set <code>--http_allow_origin</code> to the origin serving this page.</p>
          <pre><code>umask 077{\n}
          {'for role in client viewer admin; do openssl rand -hex 32 > "$role-token"; done'}{\n}
          {'bazel build //cmd/bazel_backend //tools/remote-execution-worker/...'}{\n}
          {'bazel-bin/cmd/bazel_backend/bazel_backend_/bazel_backend'} \{\n}
          {'  '}--remote_execution_client_token_file=client-token --remote_execution_viewer_token_file=viewer-token \{\n}
          {'  '}--remote_execution_admin_token_file=admin-token --remote_execution_sqlite=execution.sqlite \{\n}
          {'  '}--remote_execution_grpc_listen=127.0.0.1:1971 \{\n}
          {'  '}--remote_cache_grpc_listen=127.0.0.1:1972 --remote_cache_dir=cache \{\n}
          {'  '}--bes_backend_grpc_listen=127.0.0.1:1973 --http_listen=127.0.0.1:1974 \{\n}
          {'  '}--http_allow_origin=http://localhost:8081</code></pre>
          <p>To serve this page locally on port 8081, run <code>{'bazel run //app/bcr:release --//app/bcr:release_type=dummy -- --port=8081'}</code>.</p>
        </li>
        <li>
          <h3 class="h4">Issue a pool ticket and save the pool</h3>
          <p>Set <code>IROH_RELAY</code> to your relay URL, then start the gateway in another terminal.</p>
          <pre><code>umask 077{\n}
          {'openssl rand -hex 32 > linux-enrollment-token'}{\n}
          {'bazel-bin/tools/remote-execution-worker/remote-execution-gateway'} \{\n}
          {'  --backend=127.0.0.1:1974 --relay="$IROH_RELAY" --key-file=gateway.key'} \{\n}
          {'  '}--ticket-dir=tickets --pool-token=linux=linux-enrollment-token</code></pre>
          <p>Save the scheduler admin HTTP origin and admin token in Tools settings. Open <strong>Manage pools and instances</strong> and load the settings. Create the REAPI instance <code>builds</code>, then assign it to a pool with ID <code>linux</code>, property <code>OSFamily=Linux</code>, and the gateway ID from <code>tickets/gateway.id</code>.</p>
        </li>
        <li>
          <h3 class="h4">Start workers and connect the viewer</h3>
          <p>Give each worker the same <code>tickets/pool-linux.ticket</code>. The ticket has no automatic expiration. Each worker needs its own persistent identity file, Linux x86-64, Bubblewrap, and <code>prlimit</code>.</p>
          <pre><code>{'bazel-bin/tools/remote-execution-worker/remote-execution-worker'} \{\n}
          {'  '}--ticket-file=tickets/pool-linux.ticket --identity-file=worker-01.key --name=worker-01</code></pre>
          <p>In Tools settings, enter the scheduler origin and viewer token, or paste a read-only Iroh viewer ticket. In Remote Execution, click <strong>Connect</strong> and check <strong>Pools</strong> for an online worker.</p>
          <p><strong>Scheduler</strong> shows readiness, work in flight, and recent activity. Open a pool to watch queued actions move onto worker lanes and into completed work. A service monitor can check <code>/api/remote-execution/readyz</code> on the shared HTTP listener.</p>
        </li>
        <li>
          <h3 class="h4">Run a Bazel build</h3>
          <p>In your build workspace, set <code>EXECUTION_CLIENT_TOKEN</code> to the configured client token. Use the execution gRPC listener for both <code>--remote_executor</code> and <code>--remote_cache</code>, and match the pool’s instance and platform properties.</p>
          <pre><code>{'bazel build //path:target'} \{\n}
          {'  '}--remote_executor=grpc://127.0.0.1:1971 --remote_cache=grpc://127.0.0.1:1971 \{\n}
          {'  '}--remote_instance_name=builds \{\n}
          {'  --remote_header="authorization=Bearer $EXECUTION_CLIENT_TOKEN"'} \{\n}
          {'  '}--remote_default_exec_properties=OSFamily=Linux \{\n}
          {'  '}--spawn_strategy=remote --remote_local_fallback=false</code></pre>
          <p>Add <code>--remote_accept_cached=false</code> to test worker execution with remote cache reads disabled. The <strong>Pool</strong> tab shows which worker ran each action.</p>
        </li>
      </ol>
    </div>
  </section>
{/template}
